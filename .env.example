APP_NAME=AgenticOS
APP_ENV=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_RUNS=2
WORKSPACE_ROOT=./workspace
MEMORY_DATABASE_PATH=./.agenticos/memory.sqlite3
# Required when APP_ENV=production; keep this secret out of source control.
API_AUTH_TOKEN=

# Bootstrap administrator: use a unique high-entropy secret; never commit it.
# Leave empty to disable identity-management endpoints.
IDENTITY_ADMIN_TOKEN=
IDENTITY_ADMIN_PRINCIPAL=local-admin

# Local SQLite database for identities, grants, run checkpoints, and API audit events.
OPERATIONS_DATABASE_PATH=./.agenticos/operations.sqlite3
